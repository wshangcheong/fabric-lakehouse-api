# --- Entra service principal (app -> data access) ---
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
FABRIC_CLIENT_ID=00000000-0000-0000-0000-000000000000
FABRIC_CLIENT_SECRET=your-sp-secret

# --- Fabric Lakehouse SQL analytics endpoint ---
# Copy the "SQL analytics endpoint" server value from Fabric
# (Lakehouse -> Settings -> SQL analytics endpoint), e.g.
#   your-workspace.datawarehouse.fabric.microsoft.com,1433
FABRIC_SQL_SERVER=your-workspace.datawarehouse.fabric.microsoft.com,1433
# Leave blank if the server value already resolves the lakehouse.
FABRIC_SQL_DATABASE=
FABRIC_SQL_SCOPE=https://database.windows.net/.default
ODBC_DRIVER=ODBC Driver 18 for SQL Server

# --- App ---
APP_NAME=lakehouse-api
LOG_LEVEL=INFO
